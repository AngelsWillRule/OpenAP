run chmod 0644 /etc/systemd/system/openap-uplink-watchdog.service /etc/systemd/system/openap-uplink-watchdog.timer
run systemctl daemon-reload
run systemctl enable --now openap-uplink-watchdog.timer

echo
echo "Install AP-address startup ordering"
run mkdir -p /etc/systemd/system/dnsmasq.service.d /etc/systemd/system/hostapd.service.d
if [ "$raspberry_native" -eq 1 ]; then
  run rm -f /etc/systemd/system/dnsmasq.service.d/20-openap-wait-ap-address.conf /etc/systemd/system/hostapd.service.d/20-openap-wait-ap-address.conf
  run cp "$repo_dir/installers/openap-prepare-ap-interface.sh" /usr/local/sbin/openap-prepare-ap-interface
  run chown root:root /usr/local/sbin/openap-prepare-ap-interface
  run chmod 0755 /usr/local/sbin/openap-prepare-ap-interface
  run cp "$repo_dir/installers/openap-ap-address.service" /etc/systemd/system/openap-ap-address.service
  run cp "$repo_dir/installers/20-openap-ap-address.conf" /etc/systemd/system/dnsmasq.service.d/20-openap-ap-address.conf
  run cp "$repo_dir/installers/20-openap-hostapd-address.conf" /etc/systemd/system/hostapd.service.d/20-openap-ap-address.conf
  run cp "$repo_dir/installers/30-openap-hostapd-config.conf" /etc/systemd/system/hostapd.service.d/30-openap-hostapd-config.conf
  run chown root:root /etc/systemd/system/openap-ap-address.service /etc/systemd/system/dnsmasq.service.d/20-openap-ap-address.conf /etc/systemd/system/hostapd.service.d/20-openap-ap-address.conf /etc/systemd/system/hostapd.service.d/30-openap-hostapd-config.conf
  run chmod 0644 /etc/systemd/system/openap-ap-address.service /etc/systemd/system/dnsmasq.service.d/20-openap-ap-address.conf /etc/systemd/system/hostapd.service.d/20-openap-ap-address.conf /etc/systemd/system/hostapd.service.d/30-openap-hostapd-config.conf
else
  run rm -f /etc/systemd/system/dnsmasq.service.d/20-openap-ap-address.conf /etc/systemd/system/hostapd.service.d/20-openap-ap-address.conf /etc/systemd/system/hostapd.service.d/30-openap-hostapd-config.conf
  run cp "$repo_dir/openap-installer/config/20-openap-wait-ap-address.conf" /etc/systemd/system/dnsmasq.service.d/20-openap-wait-ap-address.conf
  run cp "$repo_dir/openap-installer/config/20-openap-wait-ap-address.conf" /etc/systemd/system/hostapd.service.d/20-openap-wait-ap-address.conf
  run chown root:root /etc/systemd/system/dnsmasq.service.d/20-openap-wait-ap-address.conf /etc/systemd/system/hostapd.service.d/20-openap-wait-ap-address.conf
  run chmod 0644 /etc/systemd/system/dnsmasq.service.d/20-openap-wait-ap-address.conf /etc/systemd/system/hostapd.service.d/20-openap-wait-ap-address.conf
fi

echo
echo "Install sudoers"
run cp "$repo_dir/installers/raspap.repeater.sudoers" "/etc/sudoers.d/$sudoers_name"
if [ "$apply" -eq 1 ]; then
  append_wifi_sudoers_rules "/etc/sudoers.d/$sudoers_name"
else
  echo "DRY-RUN: append exact sudoers rules for detected Wi-Fi interfaces and country"
fi
run chown root:root "/etc/sudoers.d/$sudoers_name"
run chmod 0440 "/etc/sudoers.d/$sudoers_name"
run visudo -cf "/etc/sudoers.d/$sudoers_name"
run cp "$repo_dir/installers/openap.txpower.sudoers" /etc/sudoers.d/091_openap_txpower
run chown root:root /etc/sudoers.d/091_openap_txpower
run chmod 0440 /etc/sudoers.d/091_openap_txpower
run visudo -cf /etc/sudoers.d/091_openap_txpower

echo
echo "Install lighttpd OpenAP service permissions"
run mkdir -p /etc/systemd/system/lighttpd.service.d
run cp "$repo_dir/installers/20-openap-privileges.conf" /etc/systemd/system/lighttpd.service.d/20-openap-privileges.conf
run chown root:root /etc/systemd/system/lighttpd.service.d/20-openap-privileges.conf
run chmod 0644 /etc/systemd/system/lighttpd.service.d/20-openap-privileges.conf
run systemctl daemon-reload
run systemctl try-restart lighttpd.service

echo
echo "Create initial OpenAP role profile"
if [ "$apply" -eq 1 ]; then
  ap_mac="$(iface_mac "$ap_iface")"
  uplink_mac="$(iface_mac "$uplink_iface")"
  ethernet_mac="$(iface_mac "$ethernet_physical_iface")"
  profile_mode="${mode//-/_}"
  cat > /etc/openap/repeater.ini <<EOF
[mode]
current = $profile_mode

[runtime]
address_backend = $address_backend
firewall_backend = $firewall_backend

[interfaces]
ap = $ap_iface
uplink = $uplink_iface
ethernet = $ethernet_iface
ethernet_physical = $ethernet_physical_iface
ap_mac = $ap_mac
uplink_mac = $uplink_mac
ethernet_mac = $ethernet_mac

[network]
subnet = 10.88.77.0/24
gateway = 10.88.77.1
dhcp_start = 10.88.77.50
dhcp_end = 10.88.77.200
ethernet_gateway =

[wireless]
country = $wireless_country
EOF
  chown www-data:www-data /etc/openap/repeater.ini
  chmod 0640 /etc/openap/repeater.ini

  # Keep the legacy hotspot state file coherent for code paths and upgrades
  # that still inspect it. The runtime role profile remains authoritative.
  python3 - "$ap_iface" "$uplink_iface" <<'PY'
from pathlib import Path
import sys

path = Path("/etc/openap/hostapd.ini")
values = {
    "WifiInterface": sys.argv[1],
    "WifiManaged": sys.argv[2],
}
lines = path.read_text(encoding="utf-8").splitlines() if path.exists() else []
seen = set()
result = []
for line in lines:
    key = line.split("=", 1)[0].strip() if "=" in line else ""
    if key in values:
        result.append(f"{key} = {values[key]}")
        seen.add(key)
    else:
        result.append(line)
for key, value in values.items():
    if key not in seen:
        result.append(f"{key} = {value}")
path.write_text("\n".join(result) + "\n", encoding="utf-8")
PY
  chown www-data:www-data /etc/openap/hostapd.ini
  chmod 0644 /etc/openap/hostapd.ini
else
  echo "DRY-RUN: create /etc/openap/repeater.ini for $mode"
  echo "DRY-RUN: synchronize /etc/openap/hostapd.ini with selected AP/uplink roles"
fi

echo
echo "Create baseline service configs if missing"
if [ "$apply" -eq 1 ]; then
  if { [ ! -f "$hostapd_config" ] || grep -q '^# Managed by OpenAP universal installer$' "$hostapd_config" || grep -q '^ssid=OpenAP$' "$hostapd_config"; } && [ -n "$ap_iface" ]; then
    mkdir -p "$(dirname "$hostapd_config")"
    cat > "$hostapd_config" <<EOF
# Managed by OpenAP universal installer
interface=$ap_iface
driver=nl80211
country_code=$wireless_country
ieee80211d=1
ssid=$hotspot_ssid
hw_mode=g
channel=6
ieee80211n=1
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
wpa_passphrase=$hotspot_password
wpa_pairwise=CCMP
rsn_pairwise=CCMP
ctrl_interface=/run/hostapd
ctrl_interface_group=0
EOF
  fi
  if [ -f "$hostapd_config" ] && [ -n "$wireless_country" ]; then
    set_config_value "$hostapd_config" country_code "$wireless_country"
    set_config_value "$hostapd_config" ieee80211d 1
  fi
  if [ -f "$hostapd_config" ]; then
    # Credentials may be preserved, but the selected runtime role is always
    # authoritative for which radio hostapd must own.
    set_config_value "$hostapd_config" interface "$ap_iface"
    chgrp www-data "$hostapd_config"
    chmod 0640 "$hostapd_config"
    if [ "$raspberry_native" -eq 1 ]; then
      rm -f /etc/hostapd/hostapd.conf
      ln -s "$hostapd_config" /etc/hostapd/hostapd.conf
    fi
  fi

  if [ -n "$wireless_country" ]; then
    cat > /etc/systemd/system/openap-regdomain.service <<EOF
[Unit]
Description=Set OpenAP wireless regulatory country
Before=hostapd.service openap-uplink.service
After=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/sbin/iw reg set $wireless_country
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  fi

  # Remove every OpenAP-generated AP profile before writing the current one.
  # DHCP subnet changes can leave an interface-specific 20-IFACE-ap.network
  # behind. If that radio becomes the uplink during a reinstall, networkd
  # would otherwise restore the old hotspot gateway on the new uplink and
  # make the former subnet appear to overlap an active network.
  for stale_ap_profile in \
    /etc/systemd/network/20-openap-ap.network \
    /etc/systemd/network/20-*-ap.network; do
    [ -f "$stale_ap_profile" ] || continue
    stale_profile_iface="$(awk -F= '$1 ~ /^[[:space:]]*Name[[:space:]]*$/ {gsub(/[[:space:]]/, "", $2); print $2; exit}' "$stale_ap_profile")"
    case "$stale_profile_iface" in
      ""|*[!A-Za-z0-9_.:-]*) ;;
      *) stale_networkd_ap_ifaces="$stale_networkd_ap_ifaces $stale_profile_iface" ;;
    esac
    rm -f "$stale_ap_profile"
  done

  # A radio selected for AP duty must not retain OpenAP's station/DHCP
  # profile from its previous uplink role.
  rm -f "/etc/systemd/network/30-${ap_iface}-sta.network"

  if [ "$raspberry_native" -eq 0 ]; then
    cat > /etc/systemd/network/20-openap-ap.network <<EOF
[Match]
Name=$ap_iface

[Link]
RequiredForOnline=no

[Network]
Address=10.88.77.1/24
DHCP=no
LinkLocalAddressing=no
ConfigureWithoutCarrier=yes
EOF

    cat > "/etc/systemd/network/10-${ethernet_iface}.network" <<EOF
[Match]
Name=$ethernet_iface

[Link]
RequiredForOnline=yes

[Network]
DHCP=ipv4
LinkLocalAddressing=ipv6
IPv6AcceptRA=yes

[DHCPv4]
RouteMetric=50
UseDNS=yes
EOF
  fi

  cat > /etc/openap/networking/openap.nft <<EOF
table ip openap_nat {
  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "$ethernet_iface" ip saddr 10.88.77.0/24 masquerade
  }
}
EOF

  cat > /etc/systemd/system/openap-firewall.service <<'EOF'
[Unit]
Description=OpenAP dedicated NAT rules
After=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/usr/sbin/nft delete table ip openap_nat
ExecStart=/usr/sbin/nft -f /etc/openap/networking/openap.nft
ExecStop=-/usr/sbin/nft delete table ip openap_nat

[Install]
WantedBy=multi-user.target
EOF

  cat > /etc/sysctl.d/90-openap-forward.conf <<'EOF'
net.ipv4.ip_forward=1
EOF
else
  echo "DRY-RUN: create /etc/hostapd/hostapd.conf if missing"
  echo "DRY-RUN: persist the selected country in hostapd and openap-regdomain.service"
  echo "DRY-RUN: create /etc/dnsmasq.d/openap-repeater.conf if missing"
fi

echo
echo "Create admin credentials if missing"
if [ "$apply" -eq 1 ]; then
  if [ ! -f /etc/openap/openap.auth ]; then
    admin_hash="$(printf '%s' "$admin_password" | php -r '$password = stream_get_contents(STDIN); echo password_hash($password, PASSWORD_BCRYPT);')"
    {
      printf '%s\n' "$admin_user"
      printf '%s\n' "$admin_hash"
    } > /etc/openap/openap.auth
    unset admin_hash
    chown www-data:www-data /etc/openap/openap.auth
    chmod 0640 /etc/openap/openap.auth
    echo "Admin credentials created for username: $admin_user"
  else
    echo "SKIP: /etc/openap/openap.auth already exists"
  fi
else
  echo "DRY-RUN: create /etc/openap/openap.auth if missing"
fi

echo
echo "Enable lighttpd PHP and OpenAP routing"
if command -v lighty-enable-mod >/dev/null 2>&1; then
  if [ "$apply" -eq 1 ]; then
    lighty-enable-mod fastcgi-php || true
  else
    echo "DRY-RUN: lighty-enable-mod fastcgi-php"
  fi
elif command -v lighttpd-enable-mod >/dev/null 2>&1; then
  if [ "$apply" -eq 1 ]; then
    lighttpd-enable-mod fastcgi-php || true
  else
    echo "DRY-RUN: lighttpd-enable-mod fastcgi-php"
  fi
else
  echo "WARN: no lighttpd module enable helper found"
fi
run mkdir -p /etc/lighttpd/conf-available /etc/lighttpd/conf-enabled
run cp "$repo_dir/openap-installer/config/50-openap-router.conf" /etc/lighttpd/conf-available/50-openap-router.conf
run ln -sf ../conf-available/50-openap-router.conf /etc/lighttpd/conf-enabled/50-openap-router.conf
run lighttpd -tt -f /etc/lighttpd/lighttpd.conf
run systemctl enable lighttpd.service
run systemctl restart lighttpd.service

echo
echo "Activate initial AP over Ethernet"
if [ "$mode" = "ap-ethernet" ]; then
  if [ "$apply" -eq 1 ]; then
    # AP-over-Ethernet has no Wi-Fi uplink. Stop any previous repeater client
    # before assigning its radio to hostapd.
    systemctl disable --now openap-uplink.service >/dev/null 2>&1 || true
    rfkill unblock wifi || true
    for network_path in /sys/class/net/*; do
      stale_iface="$(basename "$network_path")"
      [ "$stale_iface" != "$ap_iface" ] || continue
      [ -d "$network_path/wireless" ] || continue
      stale_gateway_cidr="$(ip -4 -o addr show dev "$stale_iface" | awk \
        -v previous_iface="$previous_ap_iface" -v iface="$stale_iface" \
        -v previous_gateway="$previous_ap_gateway" '
        {
          split($4, address, "/")
          if ((iface == previous_iface && previous_gateway != "" && address[1] == previous_gateway) \
              || address[1] == "10.88.77.1") {
            print $4
            exit
          }
        }
      ')"
      if [ -n "$stale_gateway_cidr" ]; then
        echo "Remove stale OpenAP gateway $stale_gateway_cidr from previous AP interface: $stale_iface"
        ip addr del "$stale_gateway_cidr" dev "$stale_iface"
      fi
    done
    if [ "$raspberry_native" -eq 1 ]; then
      systemctl daemon-reload
      # networkd may still have a deleted OpenAP AP profile cached. Reload it
      # before the address service toggles the link, otherwise networkd can
      # re-add the previous hotspot gateway when carrier returns.
      if systemctl is-active --quiet systemd-networkd.service; then
        networkctl reload
        for stale_networkd_iface in $stale_networkd_ap_ifaces; do
          networkctl reconfigure "$stale_networkd_iface" >/dev/null 2>&1 || true
        done
        networkctl reconfigure "$ap_iface" >/dev/null 2>&1 || true
      fi
      systemctl enable openap-ap-address.service
      systemctl restart openap-ap-address.service
    else
      ip link set dev "$ap_iface" down || true
      ip addr flush dev "$ap_iface"
      ip addr add 10.88.77.1/24 dev "$ap_iface"
      ip link set dev "$ap_iface" up
      networkctl reload
      for stale_networkd_iface in $stale_networkd_ap_ifaces; do
        [ "$stale_networkd_iface" = "$ap_iface" ] && continue
        networkctl reconfigure "$stale_networkd_iface" >/dev/null 2>&1 || true
      done
      networkctl reconfigure "$ap_iface"
    fi
    systemctl stop dnsmasq.service || true
    case "$dns_mode" in
      auto)
        if port53_available_on_ap; then
          dns_mode_selected="local"
          echo "DNS port 53 is available on 10.88.77.1; enabling local dnsmasq DNS."
        else
          dns_mode_selected="external"
          echo "WARNING: DNS port 53 is already occupied on 10.88.77.1 or by a wildcard listener."
          echo "Using safe fallback: dnsmasq DHCP-only with external DNS 1.1.1.1 and 1.0.0.1."
          echo "The existing DNS service was not stopped or modified."
        fi
        ;;
      local)
        if ! port53_available_on_ap; then
          echo "ERROR: --dns-mode local requested, but TCP/UDP port 53 is unavailable on 10.88.77.1." >&2
          echo "Use --dns-mode auto or --dns-mode external, or resolve the DNS conflict." >&2
          exit 1
        fi
        dns_mode_selected="local"
        ;;
      external)
        dns_mode_selected="external"
        echo "External DNS mode selected: dnsmasq will provide DHCP only."
        ;;
    esac
    configure_dnsmasq "$dns_mode_selected"
    sysctl -w net.ipv4.ip_forward=1
    systemctl daemon-reload
    systemctl unmask hostapd.service
    systemctl enable openap-regdomain.service hostapd.service dnsmasq.service openap-firewall.service
    if [ "$raspberry_native" -eq 1 ]; then
      systemctl enable openap-ap-address.service
    fi
    systemctl restart openap-regdomain.service
    dnsmasq --test
    nft -c -f /etc/openap/networking/openap.nft
    systemctl restart openap-firewall.service
    systemctl restart dnsmasq.service
    systemctl restart hostapd.service
    systemctl is-active --quiet openap-firewall.service
    systemctl is-active --quiet dnsmasq.service
    systemctl is-active --quiet hostapd.service
    echo "Initial hotspot active on $ap_iface (SSID: $hotspot_ssid, gateway: 10.88.77.1)"
    echo "DNS mode active: $dns_mode_selected"
  else
    echo "DRY-RUN: configure 10.88.77.1/24 on $ap_iface"
    echo "DRY-RUN: select DNS mode ($dns_mode) after testing TCP/UDP 10.88.77.1:53"
    echo "DRY-RUN: apply the selected regulatory country before starting hostapd"
    echo "DRY-RUN: enable and start openap-regdomain, hostapd, dnsmasq and openap-firewall"
  fi
fi

echo
echo "Done."
if [ "$apply" -eq 1 ]; then
  if [ "$mode" = "ap-ethernet" ]; then
    echo "OpenAP installed and initial AP-over-Ethernet services activated."
  else
    echo "OpenAP components installed for profile: $mode"
  fi
  print_install_summary
  unset admin_password hotspot_password
  offer_required_reboot
else
  echo "No changes were made."
fi
