#!/usr/bin/env bash
#
# OpenAP-owned file and service cleanup.
#
# Default mode is dry-run. Use --apply to perform the removal.

set -euo pipefail

apply=0
assume_yes=0
webroot="/var/www/html"
profile="/etc/openap/repeater.ini"
release_file="/etc/openap/release"
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
webroot_excludes="$repo_dir/openap-installer/config/webroot-excludes.txt"
progress_step=0
progress_total=7
progress_width=28
removed_system_paths=0
removed_web_files=0
removed_web_dirs=0
removed_config_entries=0
removed_config_dir=0

show_progress() {
  local label="$1"
  local filled percent bar

  progress_step=$((progress_step + 1))
  filled=$((progress_step * progress_width / progress_total))
  percent=$((progress_step * 100 / progress_total))
  printf -v bar '%*s' "$filled" ''
  bar=${bar// /#}
  printf '\r[%-*s] %3d%% (%d/%d) %-42s' \
    "$progress_width" "$bar" "$percent" "$progress_step" "$progress_total" "$label"
  if [ "$progress_step" -eq "$progress_total" ]; then
    printf '\n'
  fi
}

usage() {
  cat <<'EOF'
Usage: openap-uninstall [--apply] [--yes] [--webroot /var/www/html]

Removes only OpenAP-owned web files, runtime configuration, helpers and systemd
units. The default is a dry run. Installed packages, services, Wi-Fi firmware
and drivers are never removed. No uninstall backup is created.
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --apply) apply=1 ;;
    --yes|-y) assume_yes=1 ;;
    --webroot)
      webroot="${2:-}"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
  shift
done

case "$webroot" in
  /*) ;;
  *) echo "ERROR: --webroot must be an absolute path." >&2; exit 1 ;;
esac
case "$webroot" in
  /|/etc|/usr|/var|/home|/root)
    echo "ERROR: unsafe webroot refused: $webroot" >&2
    exit 1
    ;;
esac
if [ -L "$webroot" ]; then
  echo "ERROR: refusing a symbolic-link webroot: $webroot" >&2
  exit 1
fi
if [ -L /etc/openap ]; then
  echo "ERROR: refusing a symbolic-link OpenAP configuration directory: /etc/openap" >&2
  exit 1
fi

if [ ! -f "$release_file" ]; then
  echo "ERROR: OpenAP installation marker not found: $release_file" >&2
  exit 1
fi
if [ ! -r "$webroot_excludes" ]; then
  echo "ERROR: OpenAP webroot exclusion list not found: $webroot_excludes" >&2
  exit 1
fi
if [ -d "$webroot" ] \
  && { [ ! -f "$webroot/index.php" ] \
    || ! grep -q 'OpenAP WiFi access point and repeater management' "$webroot/index.php"; }; then
  echo "ERROR: refusing an unrecognized webroot without the OpenAP entrypoint: $webroot" >&2
  echo "No files or services were changed." >&2
  exit 1
fi

profile_value() {
  local key="$1"
  [ -r "$profile" ] || return 0
  awk -F ' *= *' -v wanted="$key" '$1 == wanted {print $2; exit}' "$profile"
}

valid_iface() {
  case "$1" in
    ""|*[!A-Za-z0-9_.:-]*) return 1 ;;
    *) return 0 ;;
  esac
}

ap_iface="$(profile_value ap)"
uplink_iface="$(profile_value uplink)"
ethernet_iface="$(profile_value ethernet)"
gateway="$(profile_value gateway)"
subnet="$(profile_value subnet)"

for iface in "$ap_iface" "$uplink_iface" "$ethernet_iface"; do
  [ -z "$iface" ] || valid_iface "$iface" || {
    echo "ERROR: unsafe interface name in $profile: $iface" >&2
    exit 1
  }
done

dynamic_paths=()
[ -z "$ap_iface" ] || dynamic_paths+=(
  "/etc/systemd/network/20-${ap_iface}-ap.network"
  "/etc/systemd/network/30-${ap_iface}-sta.network"
  "/etc/wpa_supplicant/wpa_supplicant-${ap_iface}.conf"
)
[ -z "$uplink_iface" ] || dynamic_paths+=(
  "/etc/systemd/network/20-${uplink_iface}-ap.network"
  "/etc/systemd/network/30-${uplink_iface}-sta.network"
  "/etc/wpa_supplicant/wpa_supplicant-${uplink_iface}.conf"
)
[ -z "$ethernet_iface" ] || dynamic_paths+=(
  "/etc/systemd/network/10-${ethernet_iface}.network"
)

owned_paths=(
  /etc/dnsmasq.d/openap-repeater.conf
  /etc/hostapd/hostapd.conf
  /etc/lighttpd/conf-available/50-openap-router.conf
  /etc/lighttpd/conf-enabled/50-openap-router.conf
  /etc/sudoers.d/090_openap_universal
  /etc/sudoers.d/091_openap_txpower
  /etc/sysctl.d/90-openap-forward.conf
  /etc/systemd/network/20-openap-ap.network
  /etc/systemd/system/dnsmasq.service.d/20-openap-ap-address.conf
  /etc/systemd/system/dnsmasq.service.d/20-openap-wait-ap-address.conf
  /etc/systemd/system/hostapd.service.d/20-openap-ap-address.conf
  /etc/systemd/system/hostapd.service.d/20-openap-wait-ap-address.conf
  /etc/systemd/system/hostapd.service.d/30-openap-hostapd-config.conf
  /etc/systemd/system/lighttpd.service.d/20-openap-privileges.conf
  /etc/systemd/system/openap-ap-address.service
  /etc/systemd/system/openap-bridge-neighbors.service
  /etc/systemd/system/openap-bridge-neighbors.timer
  /etc/systemd/system/openap-firewall.service
  /etc/systemd/system/openap-regdomain.service
  /etc/systemd/system/openap-uplink.service
  /etc/systemd/system/openap-uplink-watchdog.service
  /etc/systemd/system/openap-uplink-watchdog.timer
  /usr/local/sbin/openap-apply-ap-ethernet
  /usr/local/sbin/openap-apply-ap-ethernet-bridge
  /usr/local/sbin/openap-apply-ap-ethernet-bridge-networkd
  /usr/local/sbin/openap-apply-dhcp-settings
  /usr/local/sbin/openap-apply-encrypted-dns
  /usr/local/sbin/openap-apply-repeater-wifi
  /usr/local/sbin/openap-apply-uplink-wifi
  /usr/local/sbin/openap-detect
  /usr/local/sbin/openap-forget-uplink-wifi
  /usr/local/sbin/openap-prepare-ap-interface
  /usr/local/sbin/openap-refresh-bridge-neighbors
  /usr/local/sbin/openap-resolve-interfaces
  /usr/local/sbin/openap-run-uplink
  /usr/local/sbin/openap-scan-wifi
  /usr/local/sbin/openap-set-txpower
  /usr/local/sbin/openap-switch-interface-roles
  /usr/local/sbin/openap-system-reboot
  /usr/local/sbin/openap-udhcpc-hook
  /usr/local/sbin/openap-uplink-watchdog
  /usr/local/sbin/openap-wait-ap-address
)

echo "OpenAP uninstall plan"
echo "  AP interface:       ${ap_iface:-unknown}"
echo "  Wi-Fi uplink:       ${uplink_iface:-not configured}"
echo "  Ethernet interface: ${ethernet_iface:-unknown}"
echo "  Webroot:            $webroot"
echo
echo "The operation will:"
echo "  - stop and disable only OpenAP-owned services and timers;"
echo "  - remove only known OpenAP helpers, units and network profiles;"
echo "  - remove OpenAP web files while preserving unrelated webroot content;"
echo "  - remove /etc/openap and OpenAP-specific dnsmasq/hostapd configuration;"
echo "  - keep Lighttpd, dnsmasq, hostapd, OS packages, firmware and drivers."
echo "  - create no uninstall backup."

if [ "$apply" -eq 0 ]; then
  echo
  echo "DRY-RUN: no changes were made. Re-run with --apply to uninstall."
  exit 0
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "ERROR: --apply must run as root." >&2
  exit 1
fi

if [ "$assume_yes" -eq 0 ]; then
  [ -t 0 ] || {
    echo "ERROR: interactive confirmation is required; use --yes only for an intentional unattended uninstall." >&2
    exit 1
  }
  answer=""
  printf "Type UNINSTALL to continue: "
  IFS= read -r answer
  [ "$answer" = "UNINSTALL" ] || {
    echo "Uninstall cancelled."
    exit 0
  }
fi

systemctl disable --now \
  openap-ap-address.service \
  openap-bridge-neighbors.timer \
  openap-firewall.service \
  openap-regdomain.service \
  openap-uplink.service \
  openap-uplink-watchdog.timer 2>/dev/null || true
systemctl stop hostapd.service dnsmasq.service 2>/dev/null || true
show_progress "OpenAP services stopped"

nft delete table ip openap_nat 2>/dev/null || true

if valid_iface "$ap_iface" && [ -n "$gateway" ] && [ -n "$subnet" ]; then
  prefix="${subnet#*/}"
  case "$gateway/$prefix" in
    *[!0-9./]*) ;;
    *) ip address del "$gateway/$prefix" dev "$ap_iface" 2>/dev/null || true ;;
  esac
fi
show_progress "Firewall and AP address cleared"

for path in "${owned_paths[@]}" "${dynamic_paths[@]}"; do
  case "$path" in
    /etc/*|/usr/local/sbin/openap-*) ;;
    *) echo "ERROR: unsafe removal target: $path" >&2; exit 1 ;;
  esac
  [ -e "$path" ] || [ -L "$path" ] || continue
  rm -f -- "$path"
  removed_system_paths=$((removed_system_paths + 1))
done
rmdir -- \
  /etc/systemd/system/dnsmasq.service.d \
  /etc/systemd/system/hostapd.service.d \
  /etc/systemd/system/lighttpd.service.d 2>/dev/null || true
show_progress "OpenAP helpers and system files removed"

if [ -d "$webroot" ]; then
  webroot_real="$(realpath -e "$webroot")"
  webroot_manifest="$(mktemp /tmp/openap-uninstall-webroot.XXXXXX)"
  case "$webroot_manifest" in
    /tmp/openap-uninstall-webroot.*) ;;
    *) echo "ERROR: unexpected webroot manifest path" >&2; exit 1 ;;
  esac
  trap 'rm -f -- "${webroot_manifest:-}"' EXIT
  rsync -a --dry-run --ignore-times \
    --exclude .git \
    --exclude-from="$webroot_excludes" \
    --out-format='%n' \
    "$repo_dir"/ "$webroot"/ > "$webroot_manifest"
  printf '%s\n' 'includes/config.php' >> "$webroot_manifest"

  while IFS= read -r relative_path; do
    case "$relative_path" in
      ""|"."|*/) continue ;;
      /*|../*|*/../*|*/..) echo "ERROR: unsafe webroot manifest entry: $relative_path" >&2; exit 1 ;;
    esac
    target="$webroot/$relative_path"
    case "$target" in
      "$webroot"/*) ;;
      *) echo "ERROR: unsafe webroot target: $target" >&2; exit 1 ;;
    esac
    if [ -f "$target" ] || [ -L "$target" ]; then
      parent_real="$(realpath -e "$(dirname "$target")")"
      case "$parent_real" in
        "$webroot_real"|"$webroot_real"/*) ;;
        *) echo "ERROR: webroot target escapes through a symbolic link: $target" >&2; exit 1 ;;
      esac
      rm -f -- "$target"
      removed_web_files=$((removed_web_files + 1))
    fi
  done < "$webroot_manifest"

  while IFS= read -r relative_path; do
    case "$relative_path" in
      ""|".") continue ;;
      */) relative_path="${relative_path%/}" ;;
      *) continue ;;
    esac
    case "$relative_path" in
      /*|../*|*/../*|*/..) echo "ERROR: unsafe webroot directory entry: $relative_path" >&2; exit 1 ;;
    esac
    target="$webroot/$relative_path"
    if [ -d "$target" ] && [ ! -L "$target" ]; then
      parent_real="$(realpath -e "$(dirname "$target")")"
      case "$parent_real" in
        "$webroot_real"|"$webroot_real"/*) ;;
        *) echo "ERROR: webroot directory escapes through a symbolic link: $target" >&2; exit 1 ;;
      esac
      if rmdir -- "$target" 2>/dev/null; then
        removed_web_dirs=$((removed_web_dirs + 1))
      fi
    fi
  done < <(tac "$webroot_manifest")
  rm -f -- "$webroot_manifest"
  trap - EXIT
fi
show_progress "OpenAP web files removed"

if [ -d /etc/openap ]; then
  removed_config_entries="$(find /etc/openap -mindepth 1 -printf . 2>/dev/null | wc -c)"
  rm -rf -- /etc/openap
  removed_config_dir=1
fi
show_progress "OpenAP configuration removed"

systemctl daemon-reload
if systemctl is-active --quiet systemd-networkd.service; then
  networkctl reload || true
fi
show_progress "System services reloaded"

systemctl try-restart lighttpd.service 2>/dev/null || true
show_progress "Uninstall complete"

echo
echo "OpenAP has been uninstalled."
echo "Removal summary:"
echo "  OpenAP system files:       $removed_system_paths"
echo "  OpenAP web files:          $removed_web_files"
echo "  Empty web directories:     $removed_web_dirs"
echo "  OpenAP config entries:     $removed_config_entries"
if [ "$removed_config_dir" -eq 1 ]; then
  echo "  /etc/openap directory:     removed"
else
  echo "  /etc/openap directory:     already absent"
fi
echo "Installed OS packages, firmware and drivers were retained."
echo "A reboot is recommended after confirming that the host remains reachable."
